<?xml version="1.0" encoding="utf-8"?>
<!-- The dev-only eval surface (FOUNDATION §12, ADR-0015; §12 D10 moved the debug receiver into the
     dev source set). Merged into the `dev` flavour only, never into `emulatorStub`. Guarded by
     android.permission.DUMP, which the adb shell holds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <receiver
            android:name="dev.operator.eval.EvalReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.operator.eval.RUN_TASK" />
                <action android:name="dev.operator.eval.APPROVE_GATE" />
                <action android:name="dev.operator.eval.KILL" />
                <action android:name="dev.operator.eval.REPLAY" />
                <action android:name="dev.operator.eval.BENCH" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
