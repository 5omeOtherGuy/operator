<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0002, FOUNDATION §2.1, §2.3: LlmService runs in its own process, ":llm", so a native crash or
     an LMK kill of the model does not touch the accessibility host process. This module declares the
     same class name and process as the real :llm, which lets the emulator channel run :app without
     any native code (§4.2 R25) and keeps :app's manifest identical on every channel.
     Same UID and app id as dev.operator. No INTERNET permission here (§4.8, C12). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <service
            android:name="dev.operator.llm.LlmService"
            android:exported="false"
            android:process=":llm" />

    </application>

</manifest>
